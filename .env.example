# Copy to .env. infra/provision.py writes the real one automatically.
# The real .env is gitignored because it holds the RDS master password.

CURBLINE_REGION=us-east-1

CURBLINE_DB_HOST=curbline-db.xxxxxxxx.us-east-1.rds.amazonaws.com
CURBLINE_DB_PORT=5432
CURBLINE_DB_NAME=curbline
CURBLINE_DB_USER=curbline
CURBLINE_DB_PASSWORD=

CURBLINE_CACHE_HOST=curbline-cache.xxxxxx.0001.use1.cache.amazonaws.com
CURBLINE_CACHE_PORT=6379
CURBLINE_CACHE_TTL=300

CURBLINE_QUEUE_INGEST=https://sqs.us-east-1.amazonaws.com/000000000000/curbline-ingest
CURBLINE_QUEUE_ZONES=https://sqs.us-east-1.amazonaws.com/000000000000/curbline-zones
CURBLINE_SNS_TOPIC=arn:aws:sns:us-east-1:000000000000:curbline-advisories
CURBLINE_AUDIT_BUCKET=curbline-audit-000000000000

# usgs (no key) | floodnet (needs approval) | replay (demo)
CURBLINE_SOURCE=usgs
CURBLINE_FLOODNET_URL=
CURBLINE_FLOODNET_KEY=
CURBLINE_REPLAY_FILE=data/replay.json

# api.weather.gov rejects requests without an identifying User-Agent.
CURBLINE_NWS_UA=curbline-jhu-coursework (bonieal1@jh.edu)

# Detection parameters. Every one is a documented decision.
# Calibrated for FloodNet street depth. For CURBLINE_SOURCE=usgs raise this
# to ~60: that source measures river stage rise, a different scale entirely.
CURBLINE_DEPTH_THRESHOLD_CM=5.0
CURBLINE_READING_WINDOW_MINS=15
CURBLINE_CLUSTER_EPS_FT=1640
CURBLINE_CLUSTER_MIN_SENSORS=2
CURBLINE_SENSOR_POLL=60
CURBLINE_ALERT_POLL=300
