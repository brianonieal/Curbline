[Unit]
Description=Curbline API and dashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/curbline
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/curbline/.venv/bin/uvicorn api.server:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
